[Unit]
Description=AirSOAP backend (FastAPI, loopback only)
# whisper-server is started and stopped by the backend itself (AIRSOAP_WHISPER_LIFECYCLE=on-demand).
# Stopping this service also stops it: both run in the same systemd cgroup.

[Service]
Type=simple
WorkingDirectory=%h/AirSOAP/backend
EnvironmentFile=%h/.config/airsoap/airsoap.env
ExecStart=%h/AirSOAP/backend/.venv/bin/python -m airsoap
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
