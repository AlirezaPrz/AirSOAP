# AirSOAP configuration for the Raspberry Pi.
# Copy to ~/.config/airsoap/airsoap.env (see backend/README.md).
#
# IMPORTANT: the backend reads this file only when it starts. After ANY edit, run
#   systemctl --user daemon-reload && systemctl --user restart airsoap-backend.service
#   bash scripts/check_config.sh      (confirms the running backend has your settings)
# Put comments on their own lines. A "# note" after a value becomes part of the value.

# --- Backend ---------------------------------------------------------------
AIRSOAP_RECORDER=arecord
AIRSOAP_TRANSCRIBER=whisper-server
# From `arecord -l`: card 2 "MICROPHONE". The name form survives USB renumbering;
# plughw converts to 16 kHz mono if the mic does not support it natively.
AIRSOAP_ARECORD_DEVICE=plughw:CARD=MICROPHONE,DEV=0
AIRSOAP_MAX_RECORDING_SECONDS=1800
# Temporary audio. Default: $XDG_RUNTIME_DIR/airsoap (/run/user/<uid>, RAM-backed).
#AIRSOAP_WORK_DIR=/run/user/1000/airsoap
# Loopback only: Caddy (HTTPS) is the only way in from the network.
AIRSOAP_HOST=127.0.0.1
AIRSOAP_PORT=8000
# The built frontend (cd ~/AirSOAP/frontend && VITE_AIRSOAP_API=http npm run build), served by the backend.
AIRSOAP_FRONTEND_DIST=/home/ai-innovate/AirSOAP/frontend/dist

# --- Accounts, sign-in and HTTPS --------------------------------------------------
# The account database: accounts, password hashes, session hashes and the audit trail.
# No patient or clinical content is ever stored in it. It must be on persistent storage
# (the SD card), never /tmp or /run; the backend refuses those. Back it up (see README).
# There is no default account: create the first administrator with python -m airsoap.admin.
AIRSOAP_DATABASE_PATH=/home/ai-innovate/.local/state/airsoap/airsoap.db
# The address people type in the browser (served by Caddy). Requests that change anything must
# come from this origin. Add more, comma-separated, only if you really use another address.
AIRSOAP_ALLOWED_ORIGINS=https://raspberrypi.local
# The session cookie is sent over HTTPS only.
AIRSOAP_COOKIE_SECURE=true
# Sign-out after this many minutes without activity, and after this many hours in any case.
AIRSOAP_SESSION_IDLE_MINUTES=30
AIRSOAP_SESSION_ABSOLUTE_HOURS=12
# Failed sign-ins before a 15-minute pause: per account, and per network address.
AIRSOAP_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
AIRSOAP_LOGIN_MAX_FAILURES_PER_IP=20
# Days to keep sign-in and account audit events.
AIRSOAP_AUDIT_RETENTION_DAYS=365

# --- Whisper: started only while transcribing -----------------------------------
# The backend starts whisper-server (loopback only) when a recording is transcribed
# and stops it again, so its CPU and RAM (~650 MB) are free for the next model.
AIRSOAP_WHISPER_LIFECYCLE=on-demand
AIRSOAP_WHISPER_SERVER_PATH=/home/ai-innovate/src/whisper.cpp/build/bin/whisper-server
# The existing English small model.
AIRSOAP_WHISPER_MODEL_PATH=/home/ai-innovate/src/whisper.cpp/models/ggml-small.en.bin
AIRSOAP_WHISPER_URL=http://127.0.0.1:8178
AIRSOAP_WHISPER_THREADS=4
# Seconds to keep the model loaded after the last transcription. 0 frees it at once;
# a few seconds avoids a reload between back-to-back recordings.
AIRSOAP_WHISPER_IDLE_SECONDS=20
# Loading the model takes a few seconds; give up if it is not ready by then.
AIRSOAP_WHISPER_STARTUP_TIMEOUT_SECONDS=90
# Seconds to wait for one whole-recording transcription before giving up.
AIRSOAP_WHISPER_TIMEOUT_SECONDS=900

# --- Live transcription while recording (Phase 6) ----------------------------------
# A second whisper-server with the faster base.en model transcribes each stretch of speech
# as soon as a pause ends it. Its transcript IS the final transcript: there is no second pass
# after Stop. It runs on its own loopback port and is loaded only while recording. If it fails,
# the recording continues and the whole file is transcribed with the model above on Stop.
# Remove this line (or set AIRSOAP_LIVE=off) to go back to whole-file transcription.
AIRSOAP_LIVE_WHISPER_MODEL_PATH=/home/ai-innovate/src/whisper.cpp/models/ggml-base.en.bin
AIRSOAP_LIVE_WHISPER_URL=http://127.0.0.1:8179
# A pause this long (ms) ends a stretch of speech; a stretch with no pause is cut after this many seconds.
AIRSOAP_LIVE_PAUSE_MS=600
AIRSOAP_LIVE_MAX_BLOCK_SECONDS=15
# Show "running behind" once this many seconds are waiting to be transcribed.
AIRSOAP_LIVE_BEHIND_SECONDS=15

# --- Local language model (Ollama), for the SOAP and Clinical Review tasks ------------
AIRSOAP_AI=ollama
# Loopback only. The backend refuses any other address.
AIRSOAP_OLLAMA_URL=http://127.0.0.1:11434
# The stock Qwen 2.5 3B from `ollama list`. (airsoap-3b:latest is also installed; check its
# Modelfile with `ollama show airsoap-3b --modelfile` before using it, as it may carry its own prompt.)
AIRSOAP_OLLAMA_MODEL=qwen2.5:3b-instruct
# One task can take minutes on the Pi. Give up after this many seconds.
AIRSOAP_OLLAMA_TIMEOUT_SECONDS=600
# How long Ollama keeps the model loaded after a task (5m, 30s, 0 = unload at once).
# The backend also unloads it before the next transcription so whisper-server has the RAM.
AIRSOAP_OLLAMA_KEEP_ALIVE=5m
# Prompt + answer window in tokens. A longer window needs more RAM.
AIRSOAP_OLLAMA_NUM_CTX=8192
# Tries per task when the model's answer is unusable (the first try plus one retry).
AIRSOAP_AI_MAX_ATTEMPTS=2

# --- Optional: always-on whisper-server instead ----------------------------------
# Use deploy/whisper-server.service (keeps the model in RAM all the time) and set
# AIRSOAP_WHISPER_LIFECYCLE=external above. These are read by that unit only.
#WHISPER_MODEL=/home/ai-innovate/src/whisper.cpp/models/ggml-small.en.bin
#WHISPER_PORT=8178
#WHISPER_THREADS=4
